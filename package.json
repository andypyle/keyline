{
  "name": "keyline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run dev --filter=docs",
    "gen": "pnpm --filter @keyline/ui gen",
    "changeset": "changeset",
    "screenshots:update": "bash scripts/update-screenshots.sh",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3"
  }
}
